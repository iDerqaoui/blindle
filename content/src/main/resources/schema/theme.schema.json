{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindle.me/schema/theme.schema.json",
  "title": "Thème Blindle",
  "type": "object",
  "required": ["id", "name", "rights", "defaultSlots", "cards"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "rights": { "$ref": "#/$defs/rights" },
    "defaultSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    },
    "attributes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "rights": {
      "type": "object",
      "required": ["profile", "channels", "visibility", "imagePolicy"],
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["free", "fictional-ip", "real-people", "private"] },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["web", "discord"] }
        },
        "visibility": { "enum": ["public", "private"] },
        "imagePolicy": { "enum": ["any", "licensed-only", "generic-only", "none"] },
        "disclaimer": { "type": "string" },
        "takedownContact": { "type": "string" }
      }
    },
    "slot": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1 },
        "requiredTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "name", "hints"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rarity": { "enum": ["common", "rare", "epic", "legendary"] },
        "isTrap": { "type": "boolean" },
        "stats": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "image": { "type": "string" },
        "hints": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/hint" }
        }
      }
    },
    "hint": {
      "type": "object",
      "required": ["level", "type"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["text", "initial", "silhouette", "image-blur", "audio"] },
        "text": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["text"], "not": { "required": ["value"] } },
        { "required": ["value"], "not": { "required": ["text"] } }
      ]
    }
  }
}
