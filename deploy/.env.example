# Copier en /opt/blindle/.env sur le serveur (chmod 600) et remplir. Jamais commité.

# Domaine public (sans https://). Le DNS (A, et www) doit pointer vers l'IP du serveur.
BLINDLE_DOMAIN=example.com

# Mot de passe de la base (long, aléatoire : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Mémoire de la JVM (serveur de 4 Go : 1g suffit largement)
JAVA_OPTS=-Xmx1g

# Admin : rôle en base. Après une première connexion Google / Discord : ./make-admin.sh <ton e-mail>

# Connexion Google / Discord (facultatif). Adresses de retour à déclarer :
#   https://<domaine>/login/oauth2/code/google   et   https://<domaine>/login/oauth2/code/discord
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
